__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Local Qdrant storage
qdrant_data/

# SQLite databases (local dev only — never commit)
*.db
*.sqlite3

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Claude Code project memory
.claude/

# OS
.DS_Store
Thumbs.db
